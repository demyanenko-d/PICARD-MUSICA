; Автоматы цикла обращения к памяти и трапы.
;
; Раздел по сигналу: цикл памяти отмечен MREQ, цикл порта - IORQ, они
; взаимно исключены: автоматы этого файла и ports.pio не срабатывают на
; одном цикле. Исключение - bus_wr (ports.pio): ловит записи и в память.
;
; rom_serve здесь нет, хотя память им пользуется: он один на оба пути и
; лежит в ports.pio. Пины D0..D7 и BUFF_OE_N привязаны к блоку pio1,
; привязка у PIO блочная. Детекторы пинов не ведут, только читают уровни,
; вход PIO работает по чужим пинам.
;
;   rom_detect     ловит MREQ+RD, считает &pagetab[M1][страница] по A8..A13
;   rom_join       база из таблицы + A0..A7 -> адрес байта; нулевая
;                  запись обрывает цикл, на шину никто не выходит
;   rom_trap       выборка команды ниже 0x4000 -> адрес в очередь, ядро
;                  будится по непустой очереди

.pio_version rp2350

; Номера управляющих линий Z80 в wait gpio - числа в инструкциях.
; bus_setup.cpp сверяет их с PIN_* (bus.h).
.define public Z80_M1_N_GPIO 3
.define public Z80_WR_N_GPIO 4
.define public Z80_RD_N_GPIO 5
.define public Z80_MREQ_N_GPIO 7

; Таблица страниц выровнена на 1 << PAGE_TABLE_BASE_SHIFT (вариант): X = база
; >> сдвиг, адрес записи - in x, (32 - сдвиг) / in y, 1 / in pins, 6 /
; in null, 2. Выравнивание в bus.cpp и слово базы от ядра - отсюда же.
.define public PAGE_TABLE_BASE_SHIFT 9

; --- Детектор: поймать цикл чтения памяти и запросить базу страницы ---
;
;   IN_BASE  = A8 (GPIO 16): A8..A13 - страница по 256 байт, A14/A15 - отсев
;   JMP_PIN  = RD_N (GPIO 5)
;   X        = pagetab_base >> PAGE_TABLE_BASE_SHIFT
;
; Начало цикла подтверждается, как у портов (ports.pio): одиночная
; проверка ловилась на иголке, а ложно начатый цикл кладёт лишнее слово в
; FIFO rom_serve и ломает очерёдность.
;
; Проверка WR_N обязательна. При записи в память MREQ низкий, RD высокий,
; WR низкий. RD (GPIO5) и WR (GPIO4) соседи, наводка при спаде WR на RD -
; обычное дело: без проверки WR детектор насчитал бы подтверждения,
; rom_serve открыл бы буфер и вышел на шину навстречу процессору,
; записанный байт испортился бы - редко и вразнобой.
;
; wait здесь дешевле счётчика: при настоящей записи он держит автомат до
; конца цикла, стоит одну инструкцию.
.program rom_detect

; Два прохода по 4 такта (set y, 1), 27 нс из 428 до взгляда на адрес:
; хватает против одиночной иголки на RD.
;
; Развернуть в две пары wait/jmp нельзя: на инструкцию больше.
;
; Убирать совсем нельзя, замер на железе в одинаковых условиях:
;
;   с одним подтверждением   6 загрузок из 6
;   без подтверждения        2 загрузки из 6
.define MREQ_CONFIRM 1

.wrap_target
poll:
    set y, MREQ_CONFIRM
confirm:
    wait 0 gpio Z80_MREQ_N_GPIO ; MREQ_N низкий
    wait 1 gpio Z80_WR_N_GPIO   ; WR_N высокий: не запись
    jmp pin, poll               ; RD_N высокий: не чтение (регенерация)
    jmp y--, confirm

    ; Новую базу таблицы (смену варианта) автомат берёт сам, здесь: ядро
    ; только кладёт слово в очередь. Пустая очередь - pull noblock копирует
    ; X в OSR, база не меняется. Подсунутые ядром pull и mov x, osr ложились
    ; между mov osr, pins и in x, 23 и клали в X разряды шины вместо базы:
    ; DMA читал таблицу по мусорному адресу, вставал с ошибкой шины, и
    ; выборка ПЗУ умирала до сброса. Раньше mov osr, pins - OSR им занят.
    pull noblock
    mov x, osr
    ; ROM_BLK_N - младший разряд X: чётные варианты таблицы - подстановка,
    ; ПЗУ машины погашено. Меняется вместе с вариантом, в начале того цикла,
    ; с которого вариант действует, а не когда до пина дойдёт ядро.
    mov pins, x

    ; M1 - разряд индекса таблицы, а не только повод разбудить ядро.
    ;
    ; Сюда попадаем при активных MREQ и RD без WR - чтение памяти. Выборку
    ; команды от чтения данных отличает M1, таблица поделена им пополам:
    ; половина 0 обслуживает выборку, половина 1 - чтение данных. Так окно
    ; 0x3D00-0x3DFF отдаётся нам по выборке и машине по чтению, а
    ; знакогенератор в тех же 8 КБ остаётся целым.
    ;
    ; Пин условного перехода занят под RD_N, M1 берётся через OSR: mov osr,
    ; pins поворачивает входы так, что разряд 0 - пин IN_BASE. IN_BASE = A8
    ; (GPIO 16), значит M1_N (GPIO 3) в разряде (3 - 16) mod 32 = 19.
    mov osr, pins
    out null, 6                 ; пропустить A8..A13
    out y, 2                    ; Y = A14,A15 (GPIO 22,23 -> разряды 6,7)
    jmp y--, nofetch            ; не ноль: адрес выше 0x3FFF, не наш
    out null, 11                ; до разряда 19
    out y, 1                    ; Y = M1_N

    ; ISR = pagetab_base | (M1_N << 8) | (страница << 2). ISR не чистится:
    ; автопуш обнуляет его сам, а отбой выше идёт до первого in.
    ;
    ; push отдельной командой нет: 32-й разряд отправляет слово автопушем.
    ; Команд в pio0 ровно 32 на три автомата (rom_join без pull и push -
    ; автоподхват и автопуш).
    in x, (32 - PAGE_TABLE_BASE_SHIFT) ; pagetab_base >> сдвиг
    in y, 1                     ; половина таблицы - это и есть "переключение"
    in pins, 6                  ; A8..A13 - страница по 256 байт
    in null, 2                  ; * 4 байта на запись, 32 разряда -> автопуш
nofetch:

    ; Ядро будит rom_trap (тот же pio0, PIO0_IRQ_1) по спаду RD при низком
    ; M1: обработчик успевает погасить ПЗУ машины до открытия нашего буфера
    ; (trap_isr).

    ; Перевзвод: следующий цикл - только после снятия MREQ_N, иначе тот же
    ; цикл разобрался бы повторно.
    wait 1 gpio Z80_MREQ_N_GPIO
.wrap

% c-sdk {
#include "hardware/pio.h"

// Детектор. table_base - адрес таблицы страниц, выровненной на 512 байт.
static inline void rom_detect_program_init(PIO pio, uint sm, uint offset, uint pin_rd_n,
                                           uint pin_a8, uint pin_rom_blk_n, uintptr_t table_base) {
    pio_sm_config c = rom_detect_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin_a8);       // in pins,6 -> A8..A13
    sm_config_set_jmp_pin(&c, pin_rd_n);
    sm_config_set_out_pins(&c, pin_rom_blk_n, 1); // mov pins, x -> ROM_BLK_N
    sm_config_set_in_shift(&c, /*shift_right=*/false, /*autopush=*/true, 32);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);

    // X = table_base >> PAGE_TABLE_BASE_SHIFT, загружается до запуска.
    pio_sm_put_blocking(pio, sm, (uint32_t)(table_base >> PAGE_TABLE_BASE_SHIFT));
    pio_sm_exec_wait_blocking(pio, sm, pio_encode_pull(false, false));
    pio_sm_exec_wait_blocking(pio, sm, pio_encode_mov(pio_x, pio_osr));

    // ROM_BLK_N - автомату без рывка: сначала его уровень по X, потом
    // направление, потом функция пина (до неё пин ведёт ядро).
    const uint32_t blk = (uint32_t)((table_base >> PAGE_TABLE_BASE_SHIFT) & 1u);
    pio_sm_set_pins_with_mask(pio, sm, blk << pin_rom_blk_n, 1u << pin_rom_blk_n);
    pio_sm_set_pindirs_with_mask(pio, sm, 1u << pin_rom_blk_n, 1u << pin_rom_blk_n);
    pio_gpio_init(pio, pin_rom_blk_n);
}
%}

; --- Склейщик: база + смещение и решение "наша ли страница" ---
;
;   IN_BASE = A0 (GPIO 8), восемь бит смещения внутри страницы
.program rom_join

.wrap_target
top:
    ; Запись таблицы: (база >> 8) << 1 | ROM_BLK_N. Разряд ROM_BLK_N - на пин
    ; сразу: у страницы, которую отдаём мы, он ноль, и ПЗУ машины гаснет в
    ; этом же цикле, раньше нашего буфера. Это окно 3Dxx без подстановки:
    ; детектор выставил ROM_BLK по варианту (единица), здесь - ноль. У чужой
    ; страницы запись 1: ПЗУ машины остаётся, X = 0.
    out pins, 1                 ; ROM_BLK_N (автоподхват)
    out x, 31                   ; X = база >> 8
    jmp !x, top                 ; ноль - страница не наша: ничего не читать
                                ; и ждать следующий цикл. rom_serve стоит на
                                ; своём pull, на шину никто не выходит.

    ; ISR не чистится: автопуш обнуляет его сам, а отбой выше идёт до первого in.
    in x, 24                    ; база страницы (указатель >> 8)
    in pins, 8                  ; A0..A7 - смещение, 32-й разряд - автопуш
                                ; -> вторая цепочка DMA -> rom_serve
.wrap

% c-sdk {
#include "hardware/pio.h"

static inline void rom_join_program_init(PIO pio, uint sm, uint offset, uint pin_a0, uint pin_rom_blk_n) {
    pio_sm_config c = rom_join_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin_a0);       // in pins,8 -> A0..A7
    sm_config_set_out_pins(&c, pin_rom_blk_n, 1); // out pins, 1 -> ROM_BLK_N
    // Автопуш: 24 + 8 разрядов - ровно слово.
    sm_config_set_in_shift(&c, /*shift_right=*/false, /*autopush=*/true, 32);
    // Автоподхват: out pins, 1 ждёт слово сам, без отдельного pull.
    sm_config_set_out_shift(&c, /*shift_right=*/true, /*autopull=*/true, 32);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}

%}

; --- Трапы DivMMC: подстановка включается и выключается сама, по адресу
; выборки команды ---
;
; Точки входа 0x0000, 0x0008, 0x0038, 0x0066, 0x04C6, 0x0562; выход
; 0x1FF8-0x1FFF; немедленный вход 0x3D00-0x3DFF. Выборок сотни тысяч в
; секунду, поэтому автомат будит ядро только на выборках ниже 0x4000, а
; ядро проверяет адрес по битовой таблице трапов.
;
;   IN_BASE = A0 (GPIO 8): mov osr, pins кладёт A0..A15 в разряды 0..15
.program rom_trap

; Адрес - в очередь, а не с шины: вход в обработчик опаздывает, пока ядро
; ждёт выборку из флеша (замер: при музыке и esxDOS до 15000 раз в
; секунду M1 уже снят к чтению шины). Отложенным трапам (входы, выходы)
; срок - следующее чтение памяти, а не конец M1: адрес из очереди доходит
; до обработчика и после снятия M1. Очередь склеена на 8 слов.

; Ждать RD, а не отмерять паузу. При выборке команды /RD падает на
; полтакта позже адреса, как /MREQ, по которому читает адрес rom_detect:
; ожидание RD само даёт установившийся адрес и подстраивается под
; настоящую частоту машины.
;
; Заодно отсекается подтверждение прерывания: там M1 низкий, но RD
; высокий (низкий IORQ), и трап читал бы с шины несуществующий адрес.
;
; Отсев A14/A15, как у детекторов: выше 0x3FFF трапов нет, а выборок там
; подавляющее большинство (замер: 7350776 входов в обработчик при
; полутора тысячах полезных). IN_BASE = A0 (GPIO 8), A14 (GPIO 22) -
; разряд 14, A15 - разряд 15.
;
; Раньше стартовать не нужно: обработчик должен погасить ПЗУ машины до
; открытия нашего буфера (около 190 нс от начала цикла), ожидание RD -
; около 143 нс.
.wrap_target
    wait 0 gpio Z80_M1_N_GPIO   ; M1_N низкий: выборка команды
    wait 0 gpio Z80_RD_N_GPIO   ; RD_N низкий: адрес установился
    mov osr, pins
    out isr, 14                 ; ISR = A0..A13
    out y, 2                    ; Y = A14,A15
    jmp y--, tskip              ; не ноль: выше 0x3FFF, ядру не нужно
    push noblock                ; адрес ядру; полная очередь - слово теряется
tskip:
    wait 1 gpio Z80_M1_N_GPIO   ; конец выборки
.wrap

% c-sdk {
#include "hardware/pio.h"
static inline void rom_trap_program_init(PIO pio, uint sm, uint offset, uint pin_a0) {
    pio_sm_config c = rom_trap_program_get_default_config(offset);
    // mov osr, pins поворачивает слово к A0: A0..A15 - разряды 0..15.
    sm_config_set_in_pins(&c, pin_a0);
    sm_config_set_out_shift(&c, /*shift_right=*/true, /*autopull=*/false, 32);
    sm_config_set_in_shift(&c, /*shift_right=*/false, /*autopush=*/false, 32);
    // Передающая очередь не нужна: приёмная - 8 слов.
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, 1.0f);
    pio_sm_init(pio, sm, offset, &c);
}
%}

; --- Записи в память здесь нет ---
;
; Захват записей в память и в порты - bus_wr (ports.pio): одна инструкция
; снимает весь порт ввода (адрес, байт, IORQ), записи выше 0x3FFF он
; отсекает сам.
